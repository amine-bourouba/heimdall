{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Every command marked `main` in docs/ipc-contract.md §6, plus the minimum plugin/core permissions the main window needs: listening for the app's own events, writing to the clipboard (export/copy actions), and starting a window drag from the custom titlebar (ADR 0010, ADR 0003).",
  "windows": ["main"],
  "permissions": [
    "allow-add-mcp-server",
    "allow-add-memory-folder",
    "allow-check-for-update",
    "allow-clear-history-older-than",
    "allow-create-config-template",
    "allow-delete-config-item",
    "allow-delete-history-entry",
    "allow-delete-hook",
    "allow-delete-project",
    "allow-delete-session",
    "allow-detect-claude-cli",
    "allow-diff-file-versions",
    "allow-diff-lines",
    "allow-export-agent",
    "allow-export-analytics-csv",
    "allow-export-edit-patch",
    "allow-export-hooks",
    "allow-export-session",
    "allow-get-app-info",
    "allow-get-config-item",
    "allow-get-debug-log-page",
    "allow-get-file-history",
    "allow-get-file-version",
    "allow-get-mcp-catalog",
    "allow-get-mcp-statuses",
    "allow-get-memory-file",
    "allow-get-prefs",
    "allow-get-session",
    "allow-get-session-facets",
    "allow-get-session-messages",
    "allow-get-session-todos",
    "allow-get-sidebar-counts",
    "allow-get-stats",
    "allow-get-tray-snapshot",
    "allow-import-agent",
    "allow-import-hooks",
    "allow-install-update",
    "allow-list-all-todos",
    "allow-list-config-items",
    "allow-list-history",
    "allow-list-hooks",
    "allow-list-mcp-servers",
    "allow-list-memory-files",
    "allow-list-memory-sources",
    "allow-list-models",
    "allow-list-plugins",
    "allow-list-projects",
    "allow-list-recent-sessions",
    "allow-list-sessions",
    "allow-open-external-url",
    "allow-open-in-editor",
    "allow-open-terminal",
    "allow-pick-config-project",
    "allow-remove-mcp-server",
    "allow-remove-memory-folder",
    "allow-remove-plugin",
    "allow-reveal-in-file-manager",
    "allow-save-agent",
    "allow-save-hook",
    "allow-save-png",
    "allow-search",
    "allow-set-default-model",
    "allow-set-plugin-enabled",
    "allow-set-project-model",
    "allow-update-mcp-server",
    "allow-update-prefs",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-image",
    "core:window:allow-start-dragging"
  ]
}
