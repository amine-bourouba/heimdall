{
  "mcpServers": {
    "user-stdio": {
      "type": "stdio",
      "command": "python3",
      "args": ["-m", "server"],
      "env": {
        "API_KEY": "SENTINEL-SECRET-USER-ENV-1",
        "API_SECRET": "SENTINEL-SECRET-USER-ENV-2"
      }
    },
    "user-http": {
      "type": "http",
      "url": "https://mcp.example.com",
      "headers": {
        "Authorization": "Bearer SENTINEL-SECRET-USER-HEADER-1",
        "X-Api-Key": "SENTINEL-SECRET-USER-HEADER-2"
      }
    }
  },
  "projects": {
    "/fixture/project": {
      "mcpServers": {
        "local-db": {
          "type": "stdio",
          "command": "node",
          "args": ["db-server.js"],
          "env": {
            "DB_PASSWORD": "SENTINEL-SECRET-LOCAL-ENV-1"
          },
          "headers": {
            "X-Local-Token": "SENTINEL-SECRET-LOCAL-HEADER-1"
          }
        }
      }
    }
  }
}
